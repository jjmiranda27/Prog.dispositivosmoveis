// ============================================
// SISTEMA BANCÁRIO BYTEBANK EVOLUTION
// ============================================
abstract class Conta(
 val cliente: String,
 val numero: Int,
 saldoInicial: Double = 0.0
) {
 private var saldo: Double = 0.0
 private val historico = mutableListOf<String>()
 init {
 if (saldoInicial >= 0) {
 saldo = saldoInicial
 if (saldoInicial > 0) {
 historico.add(
 "Saldo inicial de R$${"%.2f".format(saldoInicial)}."
 )
 }
 } else {
 throw IllegalArgumentException(
 "O saldo inicial não pode ser negativo."
 )
 }
 }
 fun consultarSaldo(): Double = saldo
 fun depositar(valor: Double): Boolean {
 if (valor <= 0) {
 historico.add("Tentativa de depósito inválido: R$$valor.")
 return false
 }
 saldo += valor
 historico.add(
 "Depósito de R$${"%.2f".format(valor)} realizado."
 )
 return true
 }
 fun sacar(valor: Double): Boolean {
 if (valor <= 0) {
 historico.add("Tentativa de saque inválido: R$$valor.")
 return false
 }
 if (valor > saldo) {
 historico.add(
 "Saque de R$${"%.2f".format(valor)} recusado: saldo insuficiente."
 )
 return false
 }
 saldo -= valor
 historico.add(
 "Saque de R$${"%.2f".format(valor)} realizado."
 )
 return true
 }
 fun transferir(destino: Conta, valor: Double): Boolean {
 if (valor <= 0) {
 historico.add("Tentativa de transferência inválida: R$$valor.")
 return false
 }
 if (sacar(valor)) {
 destino.depositar(valor)
 // Substitui o registro de saque por um registro mais específico.
 historico.removeAt(historico.lastIndex)
 historico.add(
 "Transferência de R$${"%.2f".format(valor)} enviada para " +
 "a conta ${destino.numero}."
 )
 destino.registrarOperacao(
 "Transferência de R$${"%.2f".format(valor)} recebida " +
 "da conta $numero."
 )
 return true
 }
 return false
 }
 protected fun alterarSaldo(valor: Double) {
 saldo += valor
 }
 protected fun registrarOperacao(descricao: String) {
 historico.add(descricao)
 }
 fun aplicarTaxaMensal() {
 val taxa = calcularTaxaMensal()
 if (taxa > 0) {
 if (taxa <= saldo) {
 saldo -= taxa
 historico.add(
 "Taxa mensal de R$${"%.2f".format(taxa)} aplicada."
 )
 } else {
 historico.add(
 "Taxa mensal não aplicada por falta de saldo."
 )
 }
 }
 }
 abstract fun calcularTaxaMensal(): Double
 abstract fun aplicarRendimento()
 fun exibirDados() {
 println("Cliente: $cliente")
 println("Conta: $numero")
 println("Tipo: ${this::class.simpleName}")
 println("Saldo Atual: R$${"%.2f".format(saldo)}")
 }
 fun exibirHistorico() {
 println()
 println("====================================")
 println("HISTÓRICO DE OPERAÇÕES")
 println("====================================")
 if (historico.isEmpty()) {
 println("Nenhuma operação realizada.")
 } else {
 historico.forEach { println(it) }
 }
 }
}
// ============================================
// CONTA CORRENTE
// ============================================
class ContaCorrente(
 cliente: String,
 numero: Int,
 saldoInicial: Double = 0.0
) : Conta(cliente, numero, saldoInicial) {
 private val taxaMensal = 30.0
 override fun calcularTaxaMensal(): Double {
 return taxaMensal
 }
 override fun aplicarRendimento() {
 // Conta corrente não possui rendimento.
 registrarOperacao("Conta corrente: não há rendimento aplicado.")
 }
}
// ============================================
// CONTA POUPANÇA
// ============================================
class ContaPoupanca(
 cliente: String,
 numero: Int,
 saldoInicial: Double = 0.0
) : Conta(cliente, numero, saldoInicial) {
 private val taxaRendimento = 0.01
 override fun calcularTaxaMensal(): Double {
 return 10.0
 }
 override fun aplicarRendimento() {
 val saldoAntes = consultarSaldo()
 val rendimento = saldoAntes * taxaRendimento
 if (rendimento > 0) {
 alterarSaldo(rendimento)
 registrarOperacao(
 "Rendimento de R$${"%.2f".format(rendimento)} aplicado."
 )
 }
 }
}
// ============================================
// CONTA INVESTIMENTO
// ============================================
class ContaInvestimento(
 cliente: String,
 numero: Int,
 saldoInicial: Double = 0.0
) : Conta(cliente, numero, saldoInicial) {
 private val taxaRendimento = 0.02
 override fun calcularTaxaMensal(): Double {
 return 20.0
 }
 override fun aplicarRendimento() {
 val saldoAntes = consultarSaldo()
 val rendimento = saldoAntes * taxaRendimento
 if (rendimento > 0) {
 alterarSaldo(rendimento)
 registrarOperacao(
 "Rendimento de R$${"%.2f".format(rendimento)} aplicado."
 )
 }
 }
}
